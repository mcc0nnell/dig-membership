{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dig-nexus-api",
  "main": "api/worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "REGISTRATION_ENABLED": "false",
    "MEMBER_ENROLLMENT_ENABLED": "false"
  },
  "durable_objects": {"bindings": [{"name":"AUTH_STATE","class_name":"AuthState"}]},
  "migrations": [{"tag":"auth-state-v1","new_sqlite_classes":["AuthState"]}],
  "ratelimits": [{"name":"registrationRateLimiter","namespace_id":"1001","simple":{"limit":5,"period":60}}]
}
