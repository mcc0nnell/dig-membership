# Public hostname and canonical URL must match exactly, including public port.
# For HTTPS production use NEXUS_SITE_ADDRESS=nexus.example.org.
NEXUS_SITE_ADDRESS=nexus.example.org
NEXUS_PUBLIC_ORIGIN=https://nexus.example.org
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=

# Must match the numeric owner of deploy/secrets/*; keep non-root.
NEXUS_UID=1000
NEXUS_GID=1000

# Production Caddy listens on both ports; localhost CI overrides these ports.
NEXUS_HTTP_BIND=80:80
NEXUS_HTTPS_BIND=443:443
NEXUS_HTTPS_UDP_BIND=443:443/udp

# Optional prebuilt immutable image for releases, e.g. ghcr.io/<owner>/dig-nexus:sha-...
NEXUS_IMAGE=dig-nexus:local
